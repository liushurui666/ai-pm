# AI PM 服务器运行时环境变量样例。
# 运维把本文件复制到 /etc/ai-pm/ai-pm.env 后填真实值，deploy.ops.sh 会自动读取这个固定路径。

NODE_ENV=production
PORT=3003

# 公网站点地址。OAuth 登录成功后的站内跳转会优先使用这里，避免反向代理后误跳到容器内 localhost。
APP_URL=https://your-domain.example.com

# 生产 MySQL。腾讯云 MySQL 公网端口可能不是 3306，请按控制台展示端口填写。
DATABASE_URL=mysql://用户名:密码@数据库地址:端口/数据库名

# Unified Auth 会话密钥，建议使用 32 字符以上随机字符串。
AUTH_SESSION_SECRET=please-change-this-to-a-long-random-string

# 飞书登录。生产环境需要把这个回调地址同步配置到飞书开放平台。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
# 必须与 APP_URL 的公网域名一致，不能使用 localhost。
FEISHU_REDIRECT_URI=https://your-domain.example.com/api/auth/feishu/callback

# AI 模型接口，兼容 OpenAI Chat Completions。
AI_API_KEY=sk_xxxxxxxxxxxxxxxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# Bug 复现材料上传到腾讯云 COS。
TENCENT_COS_BUCKET=ai-1350977987
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_DOMAIN=ai-1350977987.cos.ap-guangzhou.myqcloud.com
TENCENT_COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
TENCENT_COS_SECRET_KEY=xxxxxxxxxxxxxxxx
TENCENT_COS_BUG_PREFIX=bug-materials
BUG_ATTACHMENT_MAX_BYTES=209715200
