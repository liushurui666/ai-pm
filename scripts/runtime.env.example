# AI PM 服务器运行时环境变量样例。
# 运维把本文件复制到 /etc/ai-pm/ai-pm.env 后填真实值，deploy.ops.sh 会自动读取这个固定路径。

NODE_ENV=production
PORT=3003
RUN_MIGRATIONS=1
RUN_AUTH_MIGRATIONS=0

# 公网站点地址。OAuth 登录成功后的站内跳转会优先使用这里，避免反向代理后误跳到容器内 localhost。
APP_URL=https://your-domain.example.com

# 生产 MySQL。腾讯云 MySQL 公网端口可能不是 3306，请按控制台展示端口填写。
DATABASE_URL=mysql://用户名:密码@数据库地址:端口/数据库名

# Unified Auth 认证库与 Better Auth 密钥。认证 PostgreSQL 已由认证平台/基础设施部署，AI PM 只连接使用，不负责部署。
AUTH_DATABASE_URL=postgresql://用户名:密码@认证数据库地址:端口/数据库名
BETTER_AUTH_SECRET=please-change-this-to-a-long-random-string

# 飞书登录。生产环境需要把 Better Auth 标准回调地址同步配置到飞书开放平台：
# https://your-domain.example.com/api/auth/oauth2/callback/feishu
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# AI 模型接口，兼容 OpenAI Chat Completions。
AI_API_KEY=sk_xxxxxxxxxxxxxxxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.7-max
# 生产可以用逗号追加已验证模型；服务端会对候选做短超时探活并缓存结果。
AI_MODELS=qwen3.7-max

# AI 自动索引 RAG。主 Web 进程只负责入队；ai-index worker 异步消费任务、生成 embedding 并写入 Qdrant。
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024
AI_RERANK_MODEL=qwen3-rerank
AI_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_pm_knowledge_chunks
REDIS_URL=redis://redis:6379
AI_INDEX_QUEUE_NAME=ai-pm-index
AI_INDEX_WORKER_CONCURRENCY=2
AI_INDEX_JOB_LOCK_MS=600000
AI_INDEX_WORKER_POLL_MS=5000
AI_INDEX_EVAL_WORKSPACE_ID=
AI_INDEX_EVAL_CASE_LIMIT=20
AI_INDEX_EVAL_TOP_K=5

# Dashboard 保存后的副作用队列。REDIS_URL 存在时使用 BullMQ；没有 Redis 时退回 MySQL 轮询队列表。
DASHBOARD_SIDE_EFFECT_QUEUE_NAME=ai-pm-dashboard-side-effects
DASHBOARD_SIDE_EFFECT_WORKER_CONCURRENCY=2
DASHBOARD_SIDE_EFFECT_JOB_LOCK_MS=300000
DASHBOARD_SIDE_EFFECT_WORKER_POLL_MS=1000

# 邮箱通知。Resend 免费档可用于内测；生产需要使用已验证域名的发件地址。
RESEND_API_KEY=
EMAIL_FROM=AI PM <notifications@your-domain.example.com>
EMAIL_REPLY_TO=

# Bug 复现材料上传到腾讯云 COS。
TENCENT_COS_BUCKET=ai-1350977987
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_DOMAIN=ai-1350977987.cos.ap-guangzhou.myqcloud.com
TENCENT_COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
TENCENT_COS_SECRET_KEY=xxxxxxxxxxxxxxxx
TENCENT_COS_BUG_PREFIX=bug-materials
BUG_ATTACHMENT_MAX_BYTES=209715200

# Bug AI 修复 Worker。Web 只创建修复任务，worker 会 clone 仓库、调用外部 Coding Runner 并创建 GitHub PR。
# 生产需要给 GITHUB_TOKEN 配置可创建分支/PR 的权限；AI_BUG_FIX_RUNNER_COMMAND 留空时 worker 会让任务失败并写入可读日志。
GITHUB_TOKEN=
AI_BUG_FIX_RUNNER_COMMAND=
AI_BUG_FIX_WORKDIR=/tmp/ai-pm-bug-fix-workspaces
AI_BUG_FIX_MAX_CHANGED_FILES=20
AI_BUG_FIX_MAX_DIFF_LINES=1500
