# AI PM 远程部署配置样例。
# 复制为 scripts/deploy.env 或放到任意路径后用 DEPLOY_ENV_FILE=/path/to/env scripts/deploy.sh 执行。

# 目标服务器 SSH 信息。
DEPLOY_HOST=your-server.example.com
DEPLOY_USER=deploy
DEPLOY_SSH_PORT=22
# DEPLOY_SSH_KEY=~/.ssh/id_rsa

# 服务器上的发布目录。脚本会在这里创建 releases/current/shared 三个目录。
DEPLOY_TARGET_DIR=/srv/ai-pm
DEPLOY_APP_NAME=ai-pm
DEPLOY_PORT=3003

# 本地要上传的生产环境变量文件。该文件不要提交，里面放 DATABASE_URL、AUTH_DATABASE_URL、BETTER_AUTH_SECRET、FEISHU_*、AI_* 等。
# 如果不设置，脚本会要求服务器 shared 目录里已经存在 DEPLOY_RUNTIME_ENV_NAME 指定的文件。
DEPLOY_RUNTIME_ENV_SOURCE=.env.production
DEPLOY_RUNTIME_ENV_NAME=.env.production

# 发布行为开关。RUN_MIGRATE=1 会执行 prisma migrate deploy；RUN_BUILD=1 会在服务器上构建 Next。
DEPLOY_RUN_INSTALL=1
DEPLOY_RUN_MIGRATE=1
DEPLOY_RUN_BUILD=1
DEPLOY_KEEP_RELEASES=5

# 重启方式：systemd、pm2、custom、none。
# systemd 需要服务器已配置同名服务；pm2 会自动 startOrRestart；custom 会执行 DEPLOY_RESTART_COMMAND。
DEPLOY_RESTART_STRATEGY=systemd
DEPLOY_SYSTEMD_SERVICE=ai-pm
# DEPLOY_RESTART_STRATEGY=pm2
# DEPLOY_RESTART_COMMAND="pm2 startOrRestart ecosystem.config.cjs --only ai-pm"

# 可选钩子，适合接入内部运维脚本，比如健康检查、Nginx reload、消息通知等。
# 命令在目标服务器执行，脚本会注入 RELEASE_DIR、CURRENT_DIR、SHARED_DIR、APP_NAME、APP_PORT。
# DEPLOY_BEFORE_REMOTE_SCRIPT="/opt/company/hooks/before-ai-pm.sh"
# DEPLOY_AFTER_REMOTE_SCRIPT="/opt/company/hooks/after-ai-pm.sh"
