generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Workspace {
  id          String  @id
  name        String
  description String?
  status      String
  createdAt   String
  updatedAt   String

  members             DashboardMember[]
  projects            Project[]
  tasks               ProjectTask[]
  risks               Risk[]
  bugs                BugReport[]
  requirements        Requirement[]
  requirementVersions RequirementVersion[]
  documents           DocumentItem[]
  weeklyInsights      WeeklyInsight[]
  repositories        ProjectRepository[]
  bugFixJobs          BugFixJob[]
  aiIndexSources      AiIndexSource[]
  aiIndexChunks       AiIndexChunk[]
  aiIndexJobs         AiIndexJob[]
  aiIndexTraces       AiIndexTrace[]
  assistantActionJobs AssistantActionJob[]
  dashboardSideEffectJobs DashboardSideEffectJob[]

  @@map("workspaces")
}

model DashboardMember {
  id                  String  @id
  workspaceId         String
  name                String
  email               String?
  avatarUrl           String? @db.VarChar(1024)
  registrationChannel String  @default("email")
  role                String
  status              String
  identities          Json
  notification        Json
  lastActiveAt        String?
  createdAt           String
  updatedAt           String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_members")
}

model Project {
  id             String  @id
  workspaceId    String
  name           String
  owner          String
  ownerMemberId  String?
  ownerOpenId    String?
  ownerUnionId   String?
  ownerUserId    String?
  ownerEmail     String?
  ownerAvatarUrl String? @db.VarChar(1024)
  status         String
  progress       Int
  health         Int
  dueDate        String
  team           Int
  riskCount      Int
  summary        String  @db.Text
  milestones     Json

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories ProjectRepository[]

  @@index([workspaceId])
  @@index([name])
  @@map("projects")
}

model ProjectTask {
  id             String  @id
  workspaceId    String
  title          String
  stage          String
  owner          String
  ownerMemberId  String?
  ownerOpenId    String?
  ownerUnionId   String?
  ownerUserId    String?
  ownerEmail     String?
  ownerAvatarUrl String? @db.VarChar(1024)
  project        String
  versionId      String?
  versionName    String?
  priority       String
  startDate      String
  dueDate        String
  aiHint         String  @db.Text

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([versionId])
  @@index([ownerMemberId])
  @@map("project_tasks")
}

model Risk {
  id             String  @id
  workspaceId    String
  title          String
  level          String
  owner          String
  ownerMemberId  String?
  ownerOpenId    String?
  ownerUnionId   String?
  ownerUserId    String?
  ownerEmail     String?
  ownerAvatarUrl String? @db.VarChar(1024)
  project        String
  mitigation     String  @db.Text

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("risks")
}

model BugReport {
  id               String           @id
  workspaceId      String
  title            String
  status           String
  severity         String
  project          String
  versionId        String?
  versionName      String?
  reporter         String
  owner            String
  ownerMemberId    String?
  ownerOpenId      String?
  ownerUnionId     String?
  ownerUserId      String?
  ownerEmail       String?
  ownerAvatarUrl   String?          @db.VarChar(1024)
  environment      String           @db.Text
  reproduction     String           @db.Text
  expected         String           @db.Text
  actual           String           @db.Text
  createdAt        String
  aiFixLatestJobId String?
  aiFixStatus      BugFixJobStatus?
  aiFixBranch      String?
  aiFixMrUrl       String?          @db.Text
  aiFixSummary     String?          @db.Text
  aiFixError       String?          @db.Text
  aiFixUpdatedAt   DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attachments BugAttachment[]
  flowRecords BugFlowRecord[]
  bugFixJobs  BugFixJob[]

  @@index([workspaceId])
  @@index([versionId])
  @@index([ownerMemberId])
  @@map("bug_reports")
}

model BugAttachment {
  id         String @id
  bugId      String
  key        String @db.VarChar(512)
  name       String
  url        String @db.Text
  type       String
  mimeType   String
  size       Int
  uploadedAt String

  bug BugReport @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@index([bugId])
  @@map("bug_attachments")
}

model BugFlowRecord {
  id       String  @id
  bugId    String
  action   String
  at       String
  operator String
  from     String?
  to       String?
  note     String? @db.Text

  bug BugReport @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@index([bugId, at])
  @@map("bug_flow_records")
}

model RequirementVersion {
  id                    String  @id
  workspaceId           String
  parentVersionId       String?
  parentVersionName     String?
  name                  String
  project               String
  status                String
  startDate             String
  releaseDate           String
  goal                  String  @db.Text
  productOwner          String?
  productOwnerMemberId  String?
  productOwnerOpenId    String?
  productOwnerUnionId   String?
  productOwnerUserId    String?
  productOwnerEmail     String?
  productOwnerAvatarUrl String? @db.VarChar(1024)
  uiOwner               String?
  uiOwnerMemberId       String?
  uiOwnerOpenId         String?
  uiOwnerUnionId        String?
  uiOwnerUserId         String?
  uiOwnerEmail          String?
  uiOwnerAvatarUrl      String? @db.VarChar(1024)
  devOwner              String?
  devOwnerMemberId      String?
  devOwnerOpenId        String?
  devOwnerUnionId       String?
  devOwnerUserId        String?
  devOwnerEmail         String?
  devOwnerAvatarUrl     String? @db.VarChar(1024)
  milestones            Json

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([parentVersionId])
  @@map("project_versions")
}

model Requirement {
  id                  String  @id
  workspaceId         String
  title               String
  priority            String
  status              String
  project             String
  versionId           String?
  versionName         String?
  owner               String
  ownerMemberId       String?
  ownerOpenId         String?
  ownerUnionId        String?
  ownerUserId         String?
  ownerEmail          String?
  ownerAvatarUrl      String? @db.VarChar(1024)
  uiLink              String? @db.Text
  documentLink        String? @db.Text
  acceptance          String  @db.Text
  aiSummary           String? @db.Text
  aiRisks             Json    @default("[]")
  aiMissingItems      Json    @default("[]")
  aiFrontendNotes     Json    @default("[]")
  aiBackendNotes      Json    @default("[]")
  aiTestingNotes      Json    @default("[]")
  aiCompletenessScore Int?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([versionId])
  @@map("requirements")
}

model DocumentItem {
  id          String @id
  workspaceId String
  title       String
  type        String
  updatedAt   String
  aiSummary   String @db.Text

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("documents")
}

model WeeklyInsight {
  id          String @id
  workspaceId String
  content     String @db.Text
  sortOrder   Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("weekly_insights")
}

model ProjectRepository {
  id               String           @id @default(cuid())
  workspaceId      String
  projectId        String?
  provider         GitProvider
  repoFullName     String
  cloneUrl         String           @db.VarChar(1024)
  defaultBranch    String           @default("main")
  packageManager   String           @default("pnpm")
  installCommand   String
  lintCommand      String?
  testCommand      String?
  buildCommand     String?
  allowedPaths     Json             @default("[]")
  blockedPaths     Json             @default("[]")
  defaultReviewers Json             @default("[]")
  status           RepositoryStatus @default(active)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  bugFixJobs BugFixJob[]

  @@index([workspaceId])
  @@index([projectId])
  @@map("project_repositories")
}

model BugFixJob {
  id           String          @id @default(cuid())
  workspaceId  String
  bugId        String
  repositoryId String
  status       BugFixJobStatus @default(queued)
  baseBranch   String
  fixBranch    String?
  commitSha    String?
  mrUrl        String?         @db.Text
  mrNumber     String?
  mrState      String?
  summary      String?         @db.Text
  changedFiles Json            @default("[]")
  error        String?         @db.Text
  requestedBy  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bug        BugReport         @relation(fields: [bugId], references: [id], onDelete: Cascade)
  repository ProjectRepository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  logs       BugFixJobLog[]
  checks     BugFixJobCheck[]

  @@index([workspaceId, status])
  @@index([bugId, createdAt])
  @@index([repositoryId])
  @@map("bug_fix_jobs")
}

model BugFixJobLog {
  id        String      @id @default(cuid())
  jobId     String
  level     JobLogLevel @default(info)
  message   String      @db.Text
  createdAt DateTime    @default(now())

  job BugFixJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@map("bug_fix_job_logs")
}

model BugFixJobCheck {
  id         String      @id @default(cuid())
  jobId      String
  name       String
  command    String      @db.Text
  status     CheckStatus
  durationMs Int?
  outputTail String?     @db.Text
  createdAt  DateTime    @default(now())

  job BugFixJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("bug_fix_job_checks")
}

model AiIndexSource {
  id                String                @id @default(cuid())
  workspaceId       String
  projectId         String?
  versionId         String?
  entityType        AiIndexEntityType
  entityId          String
  sourceProvider    AiIndexSourceProvider
  sourceType        AiIndexSourceType
  title             String
  sourceUrl         String?               @db.Text
  sourceToken       String?               @db.VarChar(512)
  contentHash       String                @db.VarChar(64)
  status            AiIndexSourceStatus   @default(pending)
  error             String?               @db.Text
  lastIndexedAt     DateTime?
  createdByMemberId String?
  metadata          Json                  @default("{}")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    AiIndexChunk[]
  jobs      AiIndexJob[]

  @@unique([workspaceId, entityType, entityId, sourceType])
  @@index([workspaceId, status])
  @@index([workspaceId, sourceProvider, sourceType])
  @@index([workspaceId, versionId])
  @@map("ai_index_sources")
}

model AiIndexChunk {
  id                  String             @id @default(cuid())
  workspaceId         String
  sourceId            String
  chunkIndex          Int
  title               String
  heading             String?
  content             String             @db.Text
  sparseText          String             @db.Text
  contentHash         String             @db.VarChar(64)
  embeddingModel      String?
  embeddingDimensions Int?
  embeddingVectorRef  String?
  sourceLocator       Json?
  metadata            Json               @default("{}")
  status              AiIndexChunkStatus @default(pending)
  error               String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    AiIndexSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, chunkIndex])
  @@index([workspaceId, status])
  @@index([workspaceId, embeddingVectorRef])
  @@index([sourceId, contentHash])
  @@map("ai_index_chunks")
}

model AiIndexJob {
  id          String            @id @default(cuid())
  workspaceId String
  sourceId    String?
  entityType  AiIndexEntityType
  entityId    String
  jobType     AiIndexJobType
  dedupeKey   String?           @unique @db.VarChar(191)
  payload     Json              @default("{}")
  status      AiIndexJobStatus  @default(pending)
  priority    Int               @default(0)
  retryCount  Int               @default(0)
  maxRetries  Int               @default(5)
  nextRunAt   DateTime?
  lockedAt    DateTime?
  lockedBy    String?
  error       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    AiIndexSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, nextRunAt])
  @@index([status, priority, createdAt])
  @@index([sourceId])
  @@map("ai_index_jobs")
}

model AiIndexTrace {
  id          String   @id @default(cuid())
  workspaceId String
  traceId     String?  @db.VarChar(191)
  name        String
  input       Json     @default("{}")
  output      Json     @default("{}")
  scores      Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, name])
  @@index([traceId])
  @@map("ai_index_traces")
}

model AssistantActionJob {
  id             String                   @id @default(cuid())
  workspaceId    String
  actionType     AssistantActionType
  targetType     AssistantActionTargetType
  scope          String
  recordIds      Json                     @default("[]")
  status         AssistantActionJobStatus @default(queued)
  requestedCount Int                      @default(0)
  successCount   Int                      @default(0)
  failedCount    Int                      @default(0)
  result         Json                     @default("{}")
  error          String?                  @db.Text
  requestedBy    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?
  lockedAt       DateTime?
  lockedBy       String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([status, createdAt])
  @@map("assistant_action_jobs")
}

model DashboardSideEffectJob {
  id          String                       @id @default(cuid())
  workspaceId String
  entityType  String
  entityId    String
  jobType     DashboardSideEffectJobType
  dedupeKey   String?                      @unique @db.VarChar(191)
  payload     Json                         @default("{}")
  status      DashboardSideEffectJobStatus @default(queued)
  priority    Int                          @default(0)
  retryCount  Int                          @default(0)
  maxRetries  Int                          @default(5)
  nextRunAt   DateTime?
  lockedAt    DateTime?
  lockedBy    String?
  error       String?                      @db.Text
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, nextRunAt])
  @@index([status, priority, createdAt])
  @@map("dashboard_side_effect_jobs")
}

enum GitProvider {
  github
  gitlab
}

enum RepositoryStatus {
  active
  disabled
}

enum BugFixJobStatus {
  queued
  preparing
  analyzing
  coding
  testing
  pushing
  mr_created
  failed
  canceled
}

enum JobLogLevel {
  info
  warn
  error
}

enum CheckStatus {
  passed
  failed
  skipped
}

enum AiIndexEntityType {
  version
  requirement
  bug
  task
  feishu_doc
  feishu_wiki
}

enum AiIndexSourceProvider {
  internal
  feishu
}

enum AiIndexSourceType {
  record
  feishu_doc
  feishu_wiki
}

enum AiIndexSourceStatus {
  pending
  indexing
  ready
  failed
  disabled
}

enum AiIndexChunkStatus {
  pending
  ready
  failed
  skipped
}

enum AiIndexJobType {
  index_entity
  sync_feishu
  embed_chunks
  rebuild_source
  cleanup_source
}

enum AiIndexJobStatus {
  pending
  running
  success
  failed
}

enum DashboardSideEffectJobType {
  notify_owner
  notify_bug_tester
  refresh_project_metrics
  cascade_version_updated
  cascade_version_deleted
}

enum DashboardSideEffectJobStatus {
  queued
  running
  succeeded
  failed
}

enum AssistantActionType {
  complete_tasks
  close_bugs
  create_tasks
  assign_tasks
}

enum AssistantActionTargetType {
  task
  bug
}

enum AssistantActionJobStatus {
  queued
  running
  succeeded
  partially_failed
  failed
}
