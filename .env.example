# 统一认证服务：AI PM 不维护用户表和认证 Cookie，登录页与 /api/auth/* 直接挂在本应用同源路由。
AUTH_SERVICE_URL=http://localhost:3004
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:3004
NEXT_PUBLIC_AUTH_CLIENT_ID=ai-pm
AUTH_CLIENT_ID=ai-pm
AUTH_CLIENT_NAME=AI PM
AUTH_ALLOWED_REDIRECT_URI=http://localhost:3004/
AUTH_SESSION_SECRET=replace-with-a-long-random-string
AUTH_ALLOW_DEV_LOGIN=true
AUTH_STORE_FILE=.auth/unified-auth-store.json
APP_URL=http://localhost:3004
NEXT_PUBLIC_APP_URL=http://localhost:3004

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3004/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3004/api/auth/github/callback

# 飞书集成：内嵌 Unified Auth 登录、通讯录和机器人通知会复用这组企业内部应用配置。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_REDIRECT_URI=http://localhost:3004/api/auth/feishu/callback

# 数据库：本地开发默认使用本机 MySQL，生产环境替换成腾讯云 MySQL。
# 工作区、成员角色、需求、任务、Bug 和 AI 修复任务都写入数据库，不再写入本地 JSON。
DATABASE_URL=mysql://ai_pm:ai_pm_local@localhost:3306/ai_pm

# AI 模型接口（OpenAI-compatible Chat Completions）
# 密钥只放在本机 .env.local 或部署平台环境变量，不要提交到 Git。
AI_API_KEY=sk_xxxxxxxxxxxxxxxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# Bug 复现材料上传：腾讯云 COS
# 存储桶：ai-1350977987（公有云专区-中国-广州）
TENCENT_COS_BUCKET=ai-1350977987
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_DOMAIN=ai-1350977987.cos.ap-guangzhou.myqcloud.com
TENCENT_COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
TENCENT_COS_SECRET_KEY=xxxxxxxxxxxxxxxx
TENCENT_COS_BUG_PREFIX=bug-materials
# 默认 200MB；更大的视频建议后续改成 COS 分块上传
BUG_ATTACHMENT_MAX_BYTES=209715200
