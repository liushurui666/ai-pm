# 飞书登录
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback
SESSION_SECRET=please-change-this-to-a-long-random-string

# 飞书多维表格真实数据源
FEISHU_BITABLE_APP_TOKEN=base_xxxxxxxxxxxxxxxx

# 可选：如果表名不是“项目 / 任务 / 风险 / 需求 / 文档 / 洞察”，再手动指定 table id
# FEISHU_PROJECTS_TABLE_ID=tblxxxxxxxxxxxxxxxx
# FEISHU_TASKS_TABLE_ID=tblxxxxxxxxxxxxxxxx
# FEISHU_RISKS_TABLE_ID=tblxxxxxxxxxxxxxxxx
# FEISHU_REQUIREMENTS_TABLE_ID=tblxxxxxxxxxxxxxxxx
# FEISHU_DOCUMENTS_TABLE_ID=tblxxxxxxxxxxxxxxxx
# FEISHU_INSIGHTS_TABLE_ID=tblxxxxxxxxxxxxxxxx

# AI 模型接口（OpenAI-compatible Chat Completions）
# 密钥只放在本机 .env.local 或部署平台环境变量，不要提交到 Git。
AI_API_KEY=sk_xxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
