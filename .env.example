# 飞书登录
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback
SESSION_SECRET=please-change-this-to-a-long-random-string

# 项目管理数据存储在本平台本地数据库文件：.ai-pm/app-database.json
# 工作区、成员角色、需求权限和通知开关由站内“成员管理”维护。
# 飞书仅用于登录、负责人选择和可选机器人通知，不再作为项目主数据源。

# AI 模型接口（OpenAI-compatible Chat Completions）
# 密钥只放在本机 .env.local 或部署平台环境变量，不要提交到 Git。
AI_API_KEY=sk_xxxxxxxxxxxxxxxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# Bug 复现材料上传：腾讯云 COS
# 存储桶：ai-1350977987（公有云专区-中国-广州）
TENCENT_COS_BUCKET=ai-1350977987
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_DOMAIN=ai-1350977987.cos.ap-guangzhou.myqcloud.com
TENCENT_COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
TENCENT_COS_SECRET_KEY=xxxxxxxxxxxxxxxx
TENCENT_COS_BUG_PREFIX=bug-materials
# 默认 200MB；更大的视频建议后续改成 COS 分块上传
BUG_ATTACHMENT_MAX_BYTES=209715200
