APP_URL=http://localhost:3004
NEXT_PUBLIC_APP_URL=http://localhost:3004

# 统一认证服务：AI PM 不维护用户表和认证 Cookie，登录页与 /api/auth/* 直接挂在本应用同源路由。
# 认证表使用独立 PostgreSQL；业务数据仍使用下面的 MySQL DATABASE_URL。
BETTER_AUTH_SECRET=replace-with-a-long-random-string
AUTH_DATABASE_URL=postgresql://ai_pm_auth:ai_pm_auth_local@localhost:5432/ai_pm_auth

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 飞书集成：内嵌 Unified Auth 登录、通讯录和机器人通知会复用这组企业内部应用配置。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# 数据库：本地开发默认使用本机 MySQL，生产环境替换成腾讯云 MySQL。
# 工作区、成员角色、需求、任务、Bug 和 AI 修复任务都写入数据库，不再写入本地 JSON。
DATABASE_URL=mysql://ai_pm:ai_pm_local@localhost:3306/ai_pm

# AI 模型接口（OpenAI-compatible Chat Completions）
# 密钥只放在本机 .env.local 或部署平台环境变量，不要提交到 Git。
AI_API_KEY=sk_xxxxxxxxxxxxxxxx
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.6-plus
# 生产下拉只展示白名单里通过 tools 兼容探活的模型；没有显式配置时默认候选对齐 ai-interview 百炼模型清单。
AI_MODELS=qwen3.6-plus,qwen3.6-max-preview,qwen3.6-flash,deepseek-v4-pro,deepseek-v4-flash,kimi-k2.6,glm-5.1,glm-4.5-air,MiniMax-M2.7,qwen-plus,qwen3.7-max

# AI 自动索引 RAG：业务写入只入队，worker 异步生成 embedding、写入 Qdrant，并通过 ChatBox knowledge tool 消费。
# Embedding 和 Reranker 默认优先复用百炼 OpenAI-compatible API Key。
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024
AI_RERANK_MODEL=qwen3-rerank
AI_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_pm_knowledge_chunks
REDIS_URL=redis://localhost:6379
AI_INDEX_QUEUE_NAME=ai-pm-index
AI_INDEX_WORKER_CONCURRENCY=2
AI_INDEX_JOB_LOCK_MS=600000
AI_INDEX_WORKER_POLL_MS=5000
AI_INDEX_EVAL_WORKSPACE_ID=
AI_INDEX_EVAL_CASE_LIMIT=20
AI_INDEX_EVAL_TOP_K=5

# Dashboard 保存后的副作用队列：飞书通知等慢任务由 worker 异步消费。
DASHBOARD_SIDE_EFFECT_QUEUE_NAME=ai-pm-dashboard-side-effects
DASHBOARD_SIDE_EFFECT_WORKER_CONCURRENCY=2
DASHBOARD_SIDE_EFFECT_JOB_LOCK_MS=300000
DASHBOARD_SIDE_EFFECT_WORKER_POLL_MS=1000

# Bug 复现材料上传：腾讯云 COS
# 存储桶：ai-1350977987（公有云专区-中国-广州）
TENCENT_COS_BUCKET=ai-1350977987
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_DOMAIN=ai-1350977987.cos.ap-guangzhou.myqcloud.com
TENCENT_COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
TENCENT_COS_SECRET_KEY=xxxxxxxxxxxxxxxx
TENCENT_COS_BUG_PREFIX=bug-materials
# 默认 200MB；更大的视频建议后续改成 COS 分块上传
BUG_ATTACHMENT_MAX_BYTES=209715200
